<?xml version='1.0' encoding='UTF-8'?>
<addons><addon id="repository.mdm.repo.dev" name="MDM Repo (Development)" version="1.0.1" provider-name="MDMAinsley">
  <extension point="xbmc.addon.repository" name="MDM Repo">
    <dir>
      <info>https://mdmainsley.github.io/repository.mdm.repo/dev/addons.xml</info>
      <checksum>https://mdmainsley.github.io/repository.mdm.repo/dev/addons.xml.md5</checksum>
	  <datadir zip="true">https://mdmainsley.github.io/repository.mdm.repo/dev/</datadir>
    </dir>
  </extension>

  <extension point="xbmc.addon.metadata">
    <summary>
	  MDM Repo
	</summary>
    <description>
	  All addons created by me.
	</description>
    <platform>
	  all
	</platform>
	<assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
  
</addon><addon id="plugin.video.mdm.flix" name="MDM Flix" version="0.4.0" provider-name="MDM">

    <requires>
        <import addon="xbmc.python" version="3.0.0" />
        <import addon="script.mdm.core" version="1.0.0" />
        <import addon="script.mdm.link" version="0.2.0" />
		<import addon="inputstream.adaptive" optional="true" />
        <import addon="script.module.cocoscrapers" version="1.0.39" optional="true" />
    </requires>

    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>

    <extension point="xbmc.addon.metadata">
        <summary>MDM Flix</summary>
        <description>Main video hub for the MDM Kodi ecosystem.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon><addon id="script.mdm.conf" name="MDM Conf" version="0.3.0" provider-name="MDMAinsley">
	   
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
  </requires>
  
  <extension point="xbmc.python.script" library="default.py" />
  
  <extension point="xbmc.addon.metadata">
    <summary>MDM setup and configuration hub</summary>
    <description>Setup hub with portable configuration builds, Koofr/WebDAV upload and download, validated previews and recoverable restore.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
  
</addon><addon id="script.mdm.core" name="MDM Core" version="1.0.0" provider-name="MDMAinsley">

  <requires>
    <import addon="xbmc.python" version="3.0.0" />
  </requires>

  <extension point="xbmc.python.script" library="default.py" />
  
  <extension point="xbmc.python.module" library="resources/lib" />

  <extension point="xbmc.addon.metadata">
    <summary>Shared backend utilities for MDM Kodi Addons</summary>
    <description>Provides shared logging, settings, path, cache, network, device, and Kodi wrapper utilities used by the MDM Kodi Addons ecosystem.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>

</addon><addon id="script.mdm.link" name="MDM Link" version="0.2.0" provider-name="MDMAinsley">
	   
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
  </requires>
  
  <extension point="xbmc.python.script" library="default.py" />
  <extension point="xbmc.python.module" library="lib" />
  
  <extension point="xbmc.addon.metadata">
    <summary>MDM Link Scraper Addon</summary>
    <description>Extensible movie and episode source search, free/direct and AllDebrid modes, with provider settings and diagnostics.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
  
